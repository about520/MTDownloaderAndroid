<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp"
        android:gravity="center_vertical">

        <Spinner
            android:id="@+id/spinKind"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="82dp" />

        <EditText
            android:id="@+id/etMusicKeyword"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:hint="搜歌名 / 歌手 / 歌单"
            android:imeOptions="actionSearch"
            android:maxLines="1"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnMusicSearch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="搜索"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvMusicStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="输入关键词开始搜索"
            android:textSize="12sp"
            android:textColor="#666666"
            android:maxLines="2"
            android:ellipsize="end" />

        <Button
            android:id="@+id/btnMusicBack"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="0dp"
            android:padding="6dp"
            android:text="← 返回"
            android:textSize="12sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnCookie"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="0dp"
            android:padding="6dp"
            android:text="会员Cookie"
            android:textSize="12sp" />
    </LinearLayout>

    <ListView
        android:id="@+id/lvMusic"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#11000000"
        android:dividerHeight="1dp" />
</LinearLayout>
